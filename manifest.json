{
  "manifest_version": 3,
  "name": "Plainly — Understand Anything Online",
  "short_name": "Plainly",
  "version": "0.4.0",
  "minimum_chrome_version": "114",
  "description": "Translate languages and turn complex online content into plain English while you browse.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Plainly — translate or simplify this page",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "services/storageService.js",
        "services/glossaryService.js",
        "services/tooltipService.js",
        "services/translator.js",
        "services/pageTextBridge.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["glossary.json", "glossary/*.json", "prompts/*.txt"],
      "matches": ["<all_urls>"]
    }
  ]
}
{
  "manifest_version": 3,
  "name": "Plainly — Plain English for Technical Websites",
  "short_name": "Plainly",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Translates technical jargon into plain English while you browse. Like Google Translate, but for tech jargon.",

  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Plainly — translate this page into plain English",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "sidePanel"
  ],

  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "host_permissions": [
    "https://github.com/*",
    "https://*.github.com/*",
    "https://vercel.com/*",
    "https://*.vercel.com/*",
    "https://www.netlify.com/*",
    "https://app.netlify.com/*",
    "https://docs.netlify.com/*",
    "https://stripe.com/*",
    "https://docs.stripe.com/*",
    "https://platform.openai.com/*",
    "https://docs.anthropic.com/*",
    "https://code.claude.com/*",
    "https://zapier.com/*",
    "https://*.zapier.com/*",
    "https://developers.notion.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://*.github.com/*",
        "https://vercel.com/*",
        "https://*.vercel.com/*",
        "https://www.netlify.com/*",
        "https://app.netlify.com/*",
        "https://docs.netlify.com/*",
        "https://stripe.com/*",
        "https://docs.stripe.com/*",
        "https://platform.openai.com/*",
        "https://docs.anthropic.com/*",
        "https://code.claude.com/*",
        "https://zapier.com/*",
        "https://*.zapier.com/*",
        "https://developers.notion.com/*"
      ],
      "js": [
        "services/storageService.js",
        "services/glossaryService.js",
        "services/tooltipService.js",
        "services/translator.js",
        "content.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["glossary.json", "glossary/*.json", "prompts/*.txt"],
      "matches": ["<all_urls>"]
    }
  ]
}
